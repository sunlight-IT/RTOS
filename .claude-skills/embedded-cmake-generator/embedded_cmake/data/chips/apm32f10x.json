{
  "family": "APM32F1",
  "vendor": "Geehy",
  "cpu": {
    "core": "Cortex-M3",
    "fpu": "none",
    "endian": "little"
  },
  "models": {
    "APM32F103VBT6": {
      "memory": [
        { "name": "FLASH", "origin": "0x08000000", "length": "128K" },
        { "name": "RAM", "origin": "0x20000000", "length": "20K" }
      ],
      "defines": ["APM32F103", "STM32F10X_MD"],
      "max_clock_hz": 96000000
    },
    "APM32F103RBT6": {
      "memory": [
        { "name": "FLASH", "origin": "0x08000000", "length": "128K" },
        { "name": "RAM", "origin": "0x20000000", "length": "20K" }
      ],
      "defines": ["APM32F103", "STM32F10X_MD"],
      "max_clock_hz": 96000000
    },
    "APM32F103C8T6": {
      "memory": [
        { "name": "FLASH", "origin": "0x08000000", "length": "64K" },
        { "name": "RAM", "origin": "0x20000000", "length": "20K" }
      ],
      "defines": ["APM32F103", "STM32F10X_MD"],
      "max_clock_hz": 96000000
    }
  },
  "default_defines": ["USE_STDPERIPH_DRIVER"],
  "header_paths": {},
  "startup": {
    "pattern": "startup_apm32f10x*.s",
    "gcc_default": "startup_apm32f10x_md.s",
    "armcc_pattern": "startup_apm32f10x*.s",
    "armcc_default": "startup_apm32f10x_md.s"
  },
  "linker": {
    "gcc_pattern": "*FLASH*.ld",
    "armcc_pattern": "*.sct"
  },
  "hal_driver_name": "",
  "ext": {
    "stm32_compatible": true,
    "note": "APM32F10x is a Chinese clone of STM32F103, compatible at the software level."
  }
}
