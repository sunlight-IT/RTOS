{
  "family": "STM32F4",
  "vendor": "STMicroelectronics",
  "cpu": {
    "core": "Cortex-M4",
    "fpu": "fpv4-sp-d16",
    "endian": "little"
  },
  "models": {
    "STM32F429ZITx": {
      "memory": [
        { "name": "FLASH", "origin": "0x08000000", "length": "2048K" },
        { "name": "RAM", "origin": "0x20000000", "length": "192K" },
        { "name": "CCMRAM", "origin": "0x10000000", "length": "64K" }
      ],
      "defines": ["STM32F429xx"],
      "max_clock_hz": 180000000
    },
    "STM32F407VGTx": {
      "memory": [
        { "name": "FLASH", "origin": "0x08000000", "length": "1024K" },
        { "name": "RAM", "origin": "0x20000000", "length": "128K" }
      ],
      "defines": ["STM32F407xx"],
      "max_clock_hz": 168000000
    }
  },
  "default_defines": ["USE_HAL_DRIVER"],
  "header_paths": {},
  "startup": {
    "pattern": "startup_stm32f4*.s",
    "gcc_default": "startup_stm32f429xx.s",
    "armcc_pattern": "startup_stm32f4*.s",
    "armcc_default": "startup_stm32f429xx.s"
  },
  "linker": {
    "gcc_pattern": "*FLASH*.ld",
    "armcc_pattern": "*.sct"
  },
  "hal_driver_name": "STM32F4xx_HAL_Driver",
  "ext": {
    "note": "STM32F4 family - Cortex-M4 with FPU. Includes F407, F429, F446 variants."
  }
}
